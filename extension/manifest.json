{
  "manifest_version": 3,
  "name": "RedRev",
  "version": "1.0.0",
  "description": "AI-powered Reddit review summaries for Amazon and Flipkart products, with pros, cons and a buy score.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://redrev.onrender.com/*"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  }
}
